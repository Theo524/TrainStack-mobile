      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F1EA"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "398b3f85-fbdc-430a-b323-a86d69a1b629"
      }
    },
    "owner": "minilobezno"
  }
}
