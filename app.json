{
  "expo": {
    "name": "Command Fit",
    "slug": "command-fit",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F1EA"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
